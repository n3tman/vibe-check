---
import AiMarks from './AiMarks.astro';
import FeatureChip from './FeatureChip.astro';
import Icon from './Icon.astro';
import Platforms from './Platforms.astro';
import ProjectIcon from './ProjectIcon.astro';
import Sparkline from './Sparkline.astro';
import StatusBadge from './StatusBadge.astro';
import type { Entry } from '../lib/data.ts';
import { CATEGORY_LABEL, HEADLINE, feature, fmtDate, fmtNum, href, osList, statusOf, summary } from '../lib/view.ts';
interface Props { p: Entry; showCategory?: boolean }
const { p, showCategory = false } = Astro.props;
const s = summary(p);
const c = p.metrics?.combined;
const head = HEADLINE[p.category].map((k) => feature(k, (p.features as any)?.[k]));
// Found features get a chip each; the ones not found fold into a single chip.
const found = head.filter((f) => f.state !== 'not-found');
const missing = head.filter((f) => f.state === 'not-found');
const flat = !!c && !c.commits_365d;
---
<article class="card" data-slug={p.slug}>
  <header class="card-head">
    <h3 class="card-title"><ProjectIcon slug={p.slug} name={p.name} size={28} /><a href={href(`p/${p.slug}/`)}>{p.name}</a></h3>
    <StatusBadge status={statusOf(p)} />
  </header>
  <p class="card-kind muted">{showCategory ? `${CATEGORY_LABEL[p.category].one} · ` : ''}{p.kind}{p.fork_of ? ` · fork of ${p.fork_of}` : ''}</p>
  {p.summary && <p class="card-summary">{p.summary}</p>}
  <Platforms os={osList(p)} />
  <dl class="card-meta">
    <div><dt>Licence</dt><dd>{s.licence ?? '—'}</dd></div>
    <div><dt>Language</dt><dd>{s.language ?? '—'}</dd></div>
    <div><dt><Icon name="users" size={12} /> Authors 90d</dt><dd>{fmtNum(s.authors90)}</dd></div>
    <div><dt><Icon name="tag" size={12} /> Last release</dt><dd title={s.lastTag ?? undefined}>{s.lastTagDate ? fmtDate(s.lastTagDate) : '—'}</dd></div>
  </dl>
  {p.repos.length > 0 && (
    flat ? (
      <p class="card-flat">No commits in the last year{c?.last_commit ? `, last on ${fmtDate(c.last_commit)}` : ''}</p>
    ) : (
      <div class="card-spark">
        <Sparkline weeks={c?.weekly_commits} width={260} height={30} />
        <span class="muted small">{c ? `${fmtNum(c.commits_365d)} commits in a year` : 'not measured yet'}</span>
      </div>
    )
  )}
  <div class="card-foot">
  <AiMarks p={p} compact />
  <ul class="fchips" aria-label="Headline features">
    {found.map((f) => <li><FeatureChip f={f} /></li>)}
    {missing.length > 0 && (
      <li><span class="fchip fchip-more" data-state="not-found" title={`Not found: ${missing.map((f) => f.label).join(', ')}`}>
        <Icon name="question" size={13} />{found.length ? `${missing.length} more not found` : `${missing.length} features not found`}<span class="sr-only">: {missing.map((f) => f.label).join(', ')}</span>
      </span></li>
    )}
  </ul>
  </div>
</article>
